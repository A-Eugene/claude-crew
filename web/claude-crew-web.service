[Unit]
Description=Claude Crew web page for the claude-crew fleet (127.0.0.1:3115)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /root/.claude/skills/claude-crew/web/server.py
WorkingDirectory=/root/.claude/skills/claude-crew/web
Environment=HOME=/root
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
