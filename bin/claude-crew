#!/usr/bin/env bash
# claude-crew — run Claude Code conversations as long-lived tmux sessions, one per
# conversation, and start, stop, restart and clear them without losing track.
#
# The model:
#   session  a tmux session named "<TMUX_PREFIX>_<conversation id>", created when
#            a conversation starts and removed when it stops. It runs a SHELL,
#            and claude is a command typed into that shell, so restarting claude
#            in place keeps the pane, its scrollback and its window name.
#   conv     a conversation: a transcript id and a descriptive title. The window
#            name is the title, so `tmux ls` stays readable.
#
# There is no fixed number of sessions. Starting a conversation creates its
# session and stopping it removes the session, so nothing sits empty.
#
# Usage:  claude-crew <command> [args]
#   setup [flags]              write/patch crew.conf (see --help)
#   status [--json]            what is running, what is saved, what is stopped
#   start [--force] [--dry-run]
#                              start every saved session that is not running;
#                              --force restarts the running ones too
#   restart [delay]            save what runs, then restart it via systemd
#                              WITHOUT killing the caller
#   stop <target>              stop a session and drop it from the saved set
#   save                       record what runs as the saved set
#   boot on|off|status         start the saved set automatically after a reboot
#   new "<title>"              start a brand new conversation
#   resume <conversation>      start a stopped conversation
#   clear <target> [--yes]     clear a session's context: a new, empty conversation
#                              under the same title, model and effort, then the
#                              old conversation is DELETED. Without --yes it only
#                              prints what would happen. Not Claude Code's /clear.
#   cleared                    SessionStart hook for Claude Code's own /clear:
#                              renames the session to its new conversation and has
#                              it ask before the old one is deleted
#   delete <conversation> [--yes]
#                              stop it if live, then delete its transcript for good
#   prompt <target> <text>     type keystrokes into a session's input box, verbatim
#   model  <target> <model>    relaunch on a new model; "default" follows crew.conf again
#   effort <target> <level>    relaunch at a new effort; "default" follows crew.conf again
#   relaunch <target>          stop and resume one session on its conversation, model and effort
#   update                     upgrade the claude binary, then restart
#   whoami                     which session is running the caller (guard input)
#   relabel                    rename sessions and windows to match what each runs
#   migrate                    rename numbered sessions from older versions
#
# Global flags:
#   --self       act on the caller's own session. The command is not run inline:
#                it is scheduled on a timer and fires once the turn has ended,
#                because stopping your own claude kills the shell that would
#                have restarted it. `delete` ignores --self: the caller's own
#                conversation is never deleted.
#   --in <secs>  how long --self waits before firing (default 15).
#   --interrupt  act on a session even while it is working, waiting on a
#                prompt, or holding an unsent draft. Without it those are refused.
#   --wait-idle  wait up to 15 minutes for a working session to finish instead
#                of refusing. --self and restart add it themselves.
#
# <target> is a tmux session name, a conversation id or its first 8 characters,
# or a loose match on a running session's title ("click" finds "[VPS] Click Clack").

set -euo pipefail

# readlink -f, not dirname alone: crew is reached through /root/Scripts/claude-crew,
# a symlink, and the unresolved path puts CREW_DIR at /root — so every run
# reported "not set up yet" while crew.conf sat in the skill directory.
CREW_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF="$CREW_DIR/crew.conf"
STATE="$CREW_DIR/sessions.state"
LEGACY_STATE="$CREW_DIR/slots.state"

# --- environment ------------------------------------------------------------
# ${HOME:-/root}: systemd-run (the detached-restart path) starts with a minimal
# environment and sets no HOME, which tripped `set -u` and failed the whole run.
HOME="${HOME:-/root}"; export HOME

# Same class of bug, and it failed far more quietly. A systemd unit's PATH is
#   /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# which does NOT contain ~/.local/bin, where `claude` lives. Every pane then ran
# `claude` -> command not found and exited instantly, while `tmux new-session`
# had already returned 0 — so the run logged "5 started" and systemd exited
# clean. A silent total failure, observed 2026-08-02 01:10. Resolve the binary
# here rather than trusting the caller's environment, so inline, systemd and
# cron all behave alike.
PATH="$HOME/.local/bin:$PATH"; export PATH

# Every python3 call here uses only the standard library. A pyenv shim on PATH
# costs about 0.4 s per call, and status makes dozens, so call the system
# interpreter directly when there is one.
if [ -x /usr/bin/python3 ]; then python3() { /usr/bin/python3 "$@"; }; fi

# --- config -----------------------------------------------------------------
WORKDIR="$HOME"
MODEL=claude-opus-5-5
EFFORT=medium
PERMISSION_MODE=auto
REMOTE_CONTROL=on
AUTOCOMPACT=auto
TMUX_PREFIX=Claude
SHELL_CMD=bash
# Seam for testing: point this at a stub to exercise the tmux mechanics without
# resuming a real conversation (two processes on one transcript interleave
# writes and corrupt it).
CLAUDE_BIN=claude

CONF_KEYS=(WORKDIR MODEL EFFORT PERMISSION_MODE REMOTE_CONTROL AUTOCOMPACT TMUX_PREFIX SHELL_CMD CLAUDE_BIN)

# Set by the global --self flag. Lets a caller act on its own session, which is
# otherwise refused. It does not run inline: see defer_self.
ALLOW_SELF=0
# How long --self waits before the deferred command fires. Set with --in <secs>.
DEFER_DELAY=15
# Every argument this run was given, for re-running it on a timer.
ORIG_ARGS=()
# Set by --interrupt: act on a session even while it is working.
INTERRUPT=0
# Set by --wait-idle: wait for a working session to go idle instead of refusing.
WAIT_IDLE=0

UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

die() { printf 'crew: %s\n' "$*" >&2; exit 1; }

load_conf() {
  [ -f "$CONF" ] || die "not set up yet — run: claude-crew setup"
  # shellcheck disable=SC1090
  source "$CONF"
  local k
  for k in "${CONF_KEYS[@]}"; do
    [ -n "${!k:-}" ] || die "crew.conf is missing $k — run: claude-crew setup"
  done
  command -v "$CLAUDE_BIN" >/dev/null || die "claude binary not found: $CLAUDE_BIN (PATH=$PATH)"
}

# Transcript store for a working directory. Claude Code encodes the cwd by
# replacing every "/" and "." with "-": /root -> -root.
projdir() { printf '%s/.claude/projects/%s\n' "$HOME" "$(printf '%s' "$WORKDIR" | sed 's#[/.]#-#g')"; }

sess_of_conv() { printf '%s_%s\n' "$TMUX_PREFIX" "$1"; }

new_uuid() { python3 -c 'import uuid; print(uuid.uuid4())'; }

# --- conversation selection --------------------------------------------------
# Emit "<id>\t<title>" for the newest $1 resumable conversations, newest first.
#
# The store holds ~1600 files, almost all automated background runs (auto-memory
# "Session learning" jobs). Blocklisting those — rather than allowlisting known
# good types — means a new kind of interactive session is never silently
# dropped. Titles are read from the tail: they are appended repeatedly, so the
# last one is near EOF, and some transcripts are over 100 MB.
list_convs() {
  python3 - "$(projdir)" "${1:-25}" <<'PY'
import json, os, re, sys, glob

projdir, limit = sys.argv[1], int(sys.argv[2])
files = sorted(glob.glob(os.path.join(projdir, "*.jsonl")),
               key=os.path.getmtime, reverse=True)

# Tolerate whitespace after the colon: a transcript written by anything other
# than Claude Code itself may use json.dumps' default spacing.
TITLE_RE = re.compile(rb'"customTitle"\s*:\s*"((?:[^"\\]|\\.)*)"')
# "VPS Claude 4 [Cognee]" -> "Cognee";  "VPS Claude 4" -> ""  (nothing descriptive)
LEGACY_RE = re.compile(r'^\s*VPS\s+Claude\s*\d+\s*(?:\[(?P<desc>.*)\]\s*)?$', re.I)
# A "[VPS]" host marker is re-applied to the title on launch. Feeding the marked
# title back in would stack it ("[VPS] [VPS] Cognee") a little further on every
# restart, so collapse runs of it to exactly one and keep the user's marker.
VPS_RE = re.compile(r'^(?:\s*\[VPS\]\s*)+', re.I)


def normalise(title):
    m = LEGACY_RE.match(title)
    if m:
        title = (m.group("desc") or "").strip()
    if VPS_RE.match(title):
        title = "[VPS] " + VPS_RE.sub("", title).strip()
    return title.strip()


def last_title(path):
    """Last customTitle in the file, scanning the tail first."""
    size = os.path.getsize(path)
    for window in (1 << 20, size):          # 1 MiB, then whole file
        with open(path, "rb") as fh:
            fh.seek(max(0, size - window))
            hits = TITLE_RE.findall(fh.read())
        if hits:
            try:
                return json.loads('"%s"' % hits[-1].decode("utf-8", "replace"))
            except Exception:
                return hits[-1].decode("utf-8", "replace")
        if window >= size:
            break
    return ""


def resumable(path):
    """True only for genuine interactive conversations.

    Automated auto-memory jobs are injected programmatically and their first
    user turn carries a literal "Human:" prefix, which a real user message never
    has. Testing record 0's type is NOT sufficient and cost a live session: records
    are not in a fixed order, so a job whose file began `ai-title, mode,
    queue-operation, ...` passed the old check, got resumed into a tmux session,
    and hung there unable to be prompted. Judge by the first user turn instead —
    a file with no user turn at all is not a conversation either.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 80:
                    break
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("type") != "user":
                    continue
                content = (d.get("message") or {}).get("content")
                if isinstance(content, list) and content and isinstance(content[0], dict):
                    text = str(content[0].get("text", ""))
                else:
                    text = str(content or "")
                return not text.lstrip().startswith("Human:")
    except Exception:
        return False
    return False


def last_user_ts(path):
    """Timestamp of the most recent *human* turn, or "" if none found.

    File mtime is the wrong ranking key: a live session's hooks rewrite its
    transcript constantly, so merely *being running* keeps a conversation at the
    top. The last user turn measures actual use instead.
    """
    size = os.path.getsize(path)
    with open(path, "rb") as fh:
        fh.seek(max(0, size - (1 << 20)))
        chunk = fh.read()
    for line in reversed(chunk.split(b"\n")):
        if b'"type":"user"' not in line and b'"type": "user"' not in line:
            continue
        try:                                  # the first line may be truncated
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") == "user" and d.get("timestamp"):
            return str(d["timestamp"])
    return ""


# mtime is a cheap prefilter over ~1600 files; only these candidates get the
# expensive tail read. Widen the multiplier if a genuinely used conversation
# ever sits outside the newest 4*limit by mtime.
cands = []
for path in files[: max(4 * limit, 20)]:
    title = normalise(last_title(path))
    # A session that was started and named but never typed into has no user turn
    # at all, and resumable() rejects it. It is still a conversation that was
    # asked for, so keep it when it carries a title. Without this, `new` creates
    # sessions that `resume`, `delete` and `clear` cannot address by name.
    if not resumable(path) and not title:
        continue
    cands.append((last_user_ts(path) or "", os.path.getmtime(path), path, title))

cands.sort(key=lambda c: (c[0], c[1]), reverse=True)
for _ts, _mt, path, title in cands[:limit]:
    sys.stdout.write("%s\t%s\n" % (os.path.basename(path)[:-6], title))
PY
}

# --- what is actually running ------------------------------------------------
# A session's name says which conversation it was started on, but a /resume or
# /clear inside it moves it to another. Read the truth out of each pane's process
# tree and Claude Code's per-process registry instead.
declare -A SESS_OF_CONV=()    # conversation id -> session it is live in
declare -A CONV_OF_SESS=()    # session         -> conversation id
declare -A PID_OF_SESS=()     # session         -> that claude's pid
declare -a SESSIONS=()        # every crew session, running claude or not

# True when a registry file is older than the process it claims to describe.
registry_is_stale() {   # $1=registry file  $2=pid
  local lstart started mtime
  lstart=$(ps -o lstart= -p "$2" 2>/dev/null) || return 1
  [ -n "$lstart" ] || return 1
  started=$(date -d "$lstart" +%s 2>/dev/null) || return 1
  mtime=$(stat -c %Y "$1" 2>/dev/null) || return 1
  [ "$mtime" -lt $((started - 5)) ]
}

conv_of_pid() {
  local cl reg id
  cl=$(tr '\0' '\n' 2>/dev/null < "/proc/$1/cmdline") || return 0
  grep -q "^${CLAUDE_BIN##*/}\$\|/${CLAUDE_BIN##*/}\$" <<<"$cl" || return 0

  # Ask the per-pid session registry FIRST. It is keyed by process id and it
  # follows an in-band conversation switch; argv only ever records what the
  # process was LAUNCHED with.
  #
  # Trusting argv alone is how this went wrong on 2026-09-02: a session was
  # re-pointed from inside with /resume, argv and the tmux window name both kept
  # saying the old conversation, so `status` reported the new one as stopped and
  # `start` launched a SECOND claude onto it. Two processes, one transcript —
  # the exact hazard the rest of this file is written to avoid.
  reg="$HOME/.claude/sessions/$1.json"
  # A registry file older than the process belongs to an earlier process that had
  # the same pid, most likely from before a reboot. Believing it would report the
  # wrong conversation, and `save` would then write that wrong id down.
  if [ -r "$reg" ] && ! registry_is_stale "$reg" "$1"; then
    id=$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("sessionId","") or "")
except Exception: print("")' "$reg" 2>/dev/null) || id=""
    if [ -n "$id" ]; then printf '%s\n' "$id"; return 0; fi
  fi
  # A claude started by hand may carry neither. grep then exits 1, pipefail
  # propagates it, and as the function's last command `set -e` killed the whole
  # script — silently, exit 1. Observed 2026-08-09.
  grep -A1 -x -- '--resume\|--session-id' <<<"$cl" | tail -1 || true
}

# The claude pid inside a session, or empty. The pane process is a shell, so
# claude is a CHILD of it — walk one level down as well as testing the pane pid.
claude_pid_in() {
  local s="$1" pane p
  tmux has-session -t "=$s" 2>/dev/null || return 0
  for pane in $(tmux list-panes -t "=$s" -F '#{pane_pid}' 2>/dev/null); do
    for p in "$pane" $(pgrep -P "$pane" 2>/dev/null); do
      if [ -n "$(conv_of_pid "$p")" ] || grep -qx -- "${CLAUDE_BIN##*/}" \
           <(tr '\0' '\n' 2>/dev/null < "/proc/$p/cmdline" | head -1) 2>/dev/null; then
        echo "$p"; return 0
      fi
    done
  done
}

# Crew sessions: "<prefix>_<uuid>", and the numbered "<prefix><n>" of older
# versions until `migrate` renames them.
list_sessions() {
  tmux list-sessions -F '#{session_name}' 2>/dev/null |
    grep -E "^${TMUX_PREFIX}(_[0-9a-f-]{36}|[0-9]+)\$" || true
}

declare -a DUPES=()      # "id sessA sessB" for a conversation held by two sessions

scan_sessions() {
  SESS_OF_CONV=(); CONV_OF_SESS=(); PID_OF_SESS=(); DUPES=(); SESSIONS=()
  local s pid id
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    SESSIONS+=("$s")
    pid=$(claude_pid_in "$s") || true
    [ -n "$pid" ] || continue
    PID_OF_SESS["$s"]="$pid"
    id=$(conv_of_pid "$pid")
    if [ -n "$id" ]; then
      # Two live processes on one conversation interleave writes into a single
      # transcript. Record it rather than letting the second one quietly
      # overwrite the first in the map.
      if [ -n "${SESS_OF_CONV[$id]:-}" ]; then
        DUPES+=("$id ${SESS_OF_CONV[$id]} $s")
      fi
      SESS_OF_CONV["$id"]="$s"
      CONV_OF_SESS["$s"]="$id"
    fi
  done < <(list_sessions)
}

# --- self-preservation ------------------------------------------------------
# Which conversation is running the shell that invoked us, if any.
#
# Every stop path in this script is fatal when aimed at the caller's own
# session: the claude that is mid-turn gets SIGTERM, the turn dies, and its
# remote control wedges. Detect it from the process tree rather than from tmux,
# because $TMUX is not reliably exported into a tool call's environment.
#
# When crew runs from systemd, cron, or a plain ssh shell there is no claude
# ancestor and this returns empty — which is exactly why `claude-crew restart`
# keeps working while an inline `start --force` is refused.
ppid_of() {
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  s=${s##*') '}                       # drop "pid (comm) ", comm may hold spaces
  set -- $s                           # $1=state $2=ppid
  [ -n "${2:-}" ] || return 1
  printf '%s\n' "$2"
}

caller_conv() {
  local p=$$ id guard=0
  while [ "$p" -gt 1 ] && [ "$guard" -lt 40 ]; do
    id=$(conv_of_pid "$p")
    [ -n "$id" ] && { printf '%s\n' "$id"; return 0; }
    p=$(ppid_of "$p") || return 0
    guard=$((guard + 1))
  done
}

# The session whose claude is an ancestor of this process, by pid. Works where
# caller_conv cannot: right after a /clear the registry may already name the
# new conversation while the session map still names the old one.
caller_sess() {
  local p=$$ s guard=0
  while [ "$p" -gt 1 ] && [ "$guard" -lt 40 ]; do
    for s in "${!PID_OF_SESS[@]}"; do
      [ "${PID_OF_SESS[$s]}" = "$p" ] && { printf '%s\n' "$s"; return 0; }
    done
    p=$(ppid_of "$p") || return 0
    guard=$((guard + 1))
  done
}

SELF_CONV=""; SELF_SESS=""
detect_self() {                       # call AFTER scan_sessions
  SELF_CONV=$(caller_conv)
  SELF_SESS=$(caller_sess)
}

# Run this same command again on a timer, detached, and stop now.
#
# Stopping your own session inline only ever completes the first half. The
# caller's claude gets SIGTERM, the tool shell that invoked crew dies with it,
# and the relaunch never runs. Hand the work to systemd instead, the same way
# `restart` does: the caller is already gone when the command fires, and under
# systemd there is no claude ancestor, so the guard does not fire a second time.
defer_self() {                        # $1=what was asked
  local unit="crew-self-$(date +%s)"
  command -v "${CREW_SYSTEMD_RUN:-systemd-run}" >/dev/null ||
    die "$1 targets your own session, and systemd-run is missing so it cannot be deferred. Nothing was done."
  "${CREW_SYSTEMD_RUN:-systemd-run}" --on-active="$DEFER_DELAY" --unit="$unit" --collect \
    --setenv=HOME="$HOME" --property=KillMode=process \
    "$CREW_DIR/bin/claude-crew" --wait-idle ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
  echo "$1 targets $SELF_SESS, the session you are running in."
  echo "scheduled $unit in ${DEFER_DELAY}s, so it runs once this turn has ended"
  echo "verify after it fires:  claude-crew status  &&  journalctl -u $unit"
  exit 0
}

# Refuse to stop the session we are running inside. $1=session, $2=what was asked.
refuse_self() {
  [ -n "$SELF_SESS" ] || return 0
  [ "$1" = "$SELF_SESS" ] || return 0
  [ "$ALLOW_SELF" = 1 ] && defer_self "$2"    # never returns
  die "$2 would stop the session you are running in ($1).
     Pass --self to run it on a timer instead, after this turn ends.
     'claude-crew restart' does the same for every session at once."
}

# What a session is doing: stopped, idle, working, dialog (a question or
# permission prompt is waiting) or draft (unsent text in the input box). Call
# after scan_sessions.
sess_activity() {       # $1=session
  local s="$1" pid="${PID_OF_SESS[$1]:-}" busy="" box scr
  [ -n "$pid" ] || { echo stopped; return 0; }
  # Claude Code keeps live state per process in ~/.claude/sessions/<pid>.json.
  local sf="$HOME/.claude/sessions/$pid.json"
  if [ -f "$sf" ]; then
    busy=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("status",""))' "$sf" 2>/dev/null || true)
  fi
  # Dialogs sit at the bottom; conversation text above them can quote the same
  # words, so read only the last lines.
  scr=$(tmux capture-pane -p -J -t "$s" 2>/dev/null | grep -v '^\s*$' | tail -8 || true)
  if grep -qE 'Enter to (confirm|select|continue)|Esc to cancel' <<<"$scr"; then echo dialog
  elif [ "$busy" = busy ] || grep -q 'esc to interrupt' <<<"$scr"; then echo working
  else
    # Past prompts in the conversation carry the same mark as the input box, so
    # read only the box itself.
    box=$(input_box "$s")
    if [ -n "$box" ] && [ "$box" != "<<no-input-box>>" ]; then echo draft; else echo idle; fi
  fi
}

# Refuse to stop a session that is working, waiting on a prompt, or holding an
# unsent draft. --interrupt overrides. With --wait-idle, wait up to 15 minutes
# for a working or prompting session to finish instead. A draft is never waited
# on, since nothing will clear it. $1=session $2=what was asked
guard_busy() {
  [ "$INTERRUPT" = 1 ] && return 0
  local s="$1" a i why
  a=$(sess_activity "$s")
  if [ "$WAIT_IDLE" = 1 ] && [[ "$a" == working || "$a" == dialog ]]; then
    echo "waiting for $(title_of_sess "$s") to finish its turn"
    for ((i = 0; i < 180; i++)); do
      sleep 5
      scan_sessions
      a=$(sess_activity "$s")
      [[ "$a" == working || "$a" == dialog ]] || break
    done
  fi
  case "$a" in
    working) why="is working on a turn" ;;
    dialog)  why="is waiting on a question or permission prompt" ;;
    draft)   why="has an unsent draft in its input box" ;;
    *) return 0 ;;
  esac
  [ "$WAIT_IDLE" = 1 ] && [ "$a" != draft ] && why="$why after 15 minutes of waiting"
  die "$2: $(title_of_sess "$s") ($s) $why. Nothing was done.
     Wait until it is idle, or pass --interrupt to $2 anyway."
}

# Is this conversation live in one of our sessions? Rescans first, so it is
# always reading the present, not a stale map.
#
# Do NOT reach for `pgrep -f -- "--resume $id"` here, however tempting. It
# matches on a flattened command line, so any process that merely MENTIONS the
# id counts — including the shell that invoked crew. That turns the launch
# verification into a check that can pass while nothing actually started.
conv_is_live() {
  scan_sessions
  [ -n "${SESS_OF_CONV[$1]:-}" ]
}

title_of_sess() {       # window name, which launch sets to the conversation title
  tmux display-message -p -t "$1" '#{window_name}' 2>/dev/null || true
}

# --- saved sessions ------------------------------------------------------------
# What start and restart bring back: sessions.state beside crew.conf,
#   <conversation id> TAB <model> TAB <effort> TAB <title>
# "-" in model or effort means "follow crew.conf".
#
# It records what is RUNNING, not what was asked for. A record of intent goes
# stale the moment a session is re-pointed from inside with /resume, or stopped
# by hand. A session that died keeps its entry, so a crash comes back on the next
# start. An entry leaves only through stop, delete, clear, or a transcript that
# no longer exists.
declare -A ST_MODEL=() ST_EFFORT=() ST_TITLE=()
declare -a ST_ORDER=()

state_read() {
  ST_MODEL=(); ST_EFFORT=(); ST_TITLE=(); ST_ORDER=()
  local id model effort title n
  if [ ! -f "$STATE" ] && [ -f "$LEGACY_STATE" ]; then
    # Older versions keyed the file by slot number: slot, id, model, effort, title.
    while IFS=$'\t' read -r n id model effort title; do
      [[ "$n" =~ ^[0-9]+$ ]] && [[ "$id" =~ $UUID_RE ]] || continue
      ST_ORDER+=("$id"); ST_MODEL[$id]="$model"; ST_EFFORT[$id]="$effort"; ST_TITLE[$id]="$title"
    done < "$LEGACY_STATE"
    return 0
  fi
  [ -f "$STATE" ] || return 0
  while IFS=$'\t' read -r id model effort title; do
    [[ "$id" =~ $UUID_RE ]] || continue
    ST_ORDER+=("$id"); ST_MODEL[$id]="$model"; ST_EFFORT[$id]="$effort"; ST_TITLE[$id]="$title"
  done < "$STATE"
}

state_write() {
  local tmp="$STATE.tmp.$$" id
  {
    echo "# claude-crew saved sessions. start and restart bring these back. Edit with claude-crew stop or save."
    echo "# conversation<TAB>model<TAB>effort<TAB>title   (\"-\" follows crew.conf)"
    for id in ${ST_ORDER[@]+"${ST_ORDER[@]}"}; do
      [ -n "${ST_MODEL[$id]+x}" ] || continue
      printf '%s\t%s\t%s\t%s\n' "$id" "${ST_MODEL[$id]}" "${ST_EFFORT[$id]}" "${ST_TITLE[$id]//$'\t'/ }"
    done
  } > "$tmp"
  mv -f "$tmp" "$STATE"
}

state_put() {           # $1=id $2=model $3=effort $4=title
  [ -n "${ST_MODEL[$1]+x}" ] || ST_ORDER+=("$1")
  ST_MODEL[$1]="$2"; ST_EFFORT[$1]="$3"; ST_TITLE[$1]="$4"
}

state_drop() {          # $1=id
  unset "ST_MODEL[$1]" "ST_EFFORT[$1]" "ST_TITLE[$1]"
}

# The --model and --effort a live claude was launched with, as "model<TAB>effort".
launch_flags_of_pid() {
  local cl m e
  cl=$(tr '\0' '\n' 2>/dev/null < "/proc/$1/cmdline") || { printf '\t\n'; return 0; }
  m=$(grep -A1 -x -- '--model' <<<"$cl" | tail -1 || true)
  e=$(grep -A1 -x -- '--effort' <<<"$cl" | tail -1 || true)
  printf '%s\t%s\n' "$m" "$e"
}

# The model and effort a conversation keeps when it is relaunched, as
# "model<TAB>effort": what its latest reply ran on, else its launch flags, else
# its saved entry. A field left empty falls back to the crew.conf default.
kept_flags() {          # $1=session it runs in, or empty  $2=conversation id  [$3=1: skip the saved entry]
  local pid="" m="" e="" lm le
  [ -n "$2" ] && IFS=$'\t' read -r m e < <(conv_flags "$2")
  [ -n "$1" ] && pid="${PID_OF_SESS[$1]:-}"
  if [ -n "$pid" ] && { [ -z "$m" ] || [ -z "$e" ]; }; then
    IFS=$'\t' read -r lm le < <(launch_flags_of_pid "$pid"); m="${m:-$lm}"; e="${e:-$le}"
  fi
  if [ -z "${3:-}" ] && [ -n "$2" ] && { [ -z "$m" ] || [ -z "$e" ]; }; then
    state_read
    if [ -n "${ST_MODEL[$2]+x}" ]; then
      m="${m:-${ST_MODEL[$2]}}"; e="${e:-${ST_EFFORT[$2]}}"
    fi
  fi
  [ "$m" = "-" ] && m=""
  [ "$e" = "-" ] && e=""
  printf '%s\t%s\n' "$m" "$e"
}

# Merge what is running now into the saved set and write it.
save_state() {
  state_read
  scan_sessions
  local s id model effort pd
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    id=${CONV_OF_SESS[$s]:-}
    [ -n "$id" ] || continue
    IFS=$'\t' read -r model effort <<<"$(kept_flags "$s" "$id" 1)"
    model="${model:-$MODEL}" effort="${effort:-$EFFORT}"
    # A session on the default stays "-" (follow crew.conf) unless someone set
    # it: a new conversation, or one already following, that still runs the
    # default. An explicit value, even one equal to the default, stays explicit.
    if [ -z "${ST_MODEL[$id]+x}" ] || [ "${ST_MODEL[$id]}" = "-" ]; then
      [ "$model" = "$MODEL" ] && model="-"
    fi
    if [ -z "${ST_EFFORT[$id]+x}" ] || [ "${ST_EFFORT[$id]}" = "-" ]; then
      [ "$effort" = "$EFFORT" ] && effort="-"
    fi
    state_put "$id" "$model" "$effort" "$(title_of_sess "$s")"
  done
  # Drop what can no longer be brought back: a stopped conversation with no
  # transcript. A running one may not have written its transcript yet.
  pd=$(projdir)
  for id in ${ST_ORDER[@]+"${ST_ORDER[@]}"}; do
    [ -f "$pd/$id.jsonl" ] || [ -n "${SESS_OF_CONV[$id]:-}" ] || state_drop "$id"
  done
  state_write
}

status_saved() {
  state_read
  if [ "${#ST_ORDER[@]}" -eq 0 ]; then
    echo "saved: nothing, so start brings back nothing. Run claude-crew save to keep what runs."
    return 0
  fi
  echo "saved (what start and restart bring back):"
  local id m e
  for id in "${ST_ORDER[@]}"; do
    [ -n "${ST_MODEL[$id]+x}" ] || continue
    m="${ST_MODEL[$id]}"; e="${ST_EFFORT[$id]}"
    [ "$m" = "-" ] && m="default($MODEL)"
    [ "$e" = "-" ] && e="default($EFFORT)"
    printf '  %s  %s/%s  %s%s\n' "${id:0:8}" "$m" "$e" "${ST_TITLE[$id]:-untitled}" \
      "$([ -n "${SESS_OF_CONV[$id]:-}" ] || echo '  (not running)')"
  done
}

# --- pane and process control ------------------------------------------------
# Create the tmux session running a SHELL if it does not exist. The pane must
# outlive claude — that is what makes a restart cheap — so the shell is the pane
# process and claude is only ever typed into it.
ensure_pane() {
  local s="$1"
  if ! tmux has-session -t "=$s" 2>/dev/null; then
    tmux new-session -d -s "$s" -n "$s" -c "$WORKDIR" "$SHELL_CMD"
  fi
  # Wait for the shell to be ready to read. send-keys into a pane whose process
  # has not reached its read loop can be dropped by the tty.
  local i
  for ((i = 0; i < 50; i++)); do
    [ -n "$(tmux list-panes -t "=$s" -F '#{pane_pid}' 2>/dev/null)" ] && { sleep 0.2; return 0; }
    sleep 0.1
  done
  die "pane $s never became ready"
}

# $1=conv id  $2=title (may be empty)  $3=model  $4=effort  [$5=new: start a new
# conversation with this id instead of resuming it]
claude_cmd() {
  local id="$1" title="$2" model="${3:-$MODEL}" effort="${4:-$EFFORT}"
  local -a a=("$CLAUDE_BIN" --permission-mode "$PERMISSION_MODE" --model "$model" --effort "$effort"
              --autocompact "$AUTOCOMPACT")
  [ -n "$title" ] && a+=(-n "$title")
  if [ "$REMOTE_CONTROL" = on ]; then
    if [ -n "$title" ]; then a+=(--remote-control "$title"); else a+=(--remote-control); fi
  fi
  if [ "${5:-}" = new ]; then a+=(--session-id "$id"); else a+=(--resume "$id"); fi
  printf '%q ' "${a[@]}"
}

# The model and effort the conversation actually runs on, as "model<TAB>effort":
# those of its latest real reply. /model and /effort inside the session change
# these and never the launch flags. Empty fields when it has not replied yet.
conv_flags() {          # $1=conversation id
  local f; f="$(projdir)/$1.jsonl"
  [ -n "$1" ] && [ -f "$f" ] || { printf '\t\n'; return 0; }
  python3 - "$f" <<'PY2'
import json, os, sys
p = sys.argv[1]; size = os.path.getsize(p)
with open(p, "rb") as fh:
    fh.seek(max(0, size - (1 << 20)))
    lines = fh.read().split(b"\n")
for line in reversed(lines):
    if b'"assistant"' not in line: continue
    try: d = json.loads(line)
    except Exception: continue
    m = (d.get("message") or {}).get("model") or ""
    if d.get("type") != "assistant" or not m or m.startswith("<"): continue
    print("%s\t%s" % (m, d.get("effort") or "")); break
else:
    print("\t")
PY2
}

# The conversation's own title: the last customTitle in its transcript, which is
# what /rename inside the session writes. Empty when it has none.
conv_title() {          # $1=conversation id
  local f; f="$(projdir)/$1.jsonl"
  [ -n "$1" ] && [ -f "$f" ] || return 0
  python3 - "$f" <<'PY2'
import json, re, sys
import os
p = sys.argv[1]; size = os.path.getsize(p); hits = []
for window in (1 << 20, size):          # the tail first; titles are re-appended often
    with open(p, "rb") as fh:
        fh.seek(max(0, size - window))
        hits = re.findall(rb'"customTitle"\s*:\s*"((?:[^"\\]|\\.)*)"', fh.read())
    if hits or window >= size: break
if hits:
    try: t = json.loads('"%s"' % hits[-1].decode("utf-8", "replace"))
    except Exception: t = hits[-1].decode("utf-8", "replace")
    # One "[VPS]" marker, never a stack of them (launch re-applies it).
    m = re.match(r'^(?:\s*\[VPS\]\s*)+', t, re.I)
    print(("[VPS] " + t[m.end():].strip()) if m else t.strip())
PY2
}

# Start claude on a conversation in its session, creating the session if
# needed. $1=session $2=id $3=title [$4=model $5=effort $6=new]
start_claude_in() {
  local s="$1" id="$2" title="$3" cmd
  # The conversation's title wins over whatever the caller passed, which is
  # usually the window name: /rename changes the title and never the window, so
  # launching under the window name would undo the rename.
  local own; own=$(conv_title "$id")
  [ -n "$own" ] && title="$own"
  ensure_pane "$s"
  tmux rename-window -t "$s" "${title:-${id:0:8}}" 2>/dev/null || true
  cmd=$(claude_cmd "$id" "$title" "${4:-}" "${5:-}" "${6:-}")
  tmux send-keys -t "$s" -l -- "$cmd"
  tmux send-keys -t "$s" Enter
}

# Stop the claude in a session and LEAVE THE PANE. SIGTERM lets claude flush its
# transcript; SIGKILL is the last resort after 30s.
stop_claude_in() {
  # Declared on separate lines on purpose: bash marks every name in a single
  # `local` statement local BEFORE evaluating any of the right-hand sides, so
  # `local s="$1" pid="${PID_OF_SESS[$s]:-}"` reads an already-localised, still
  # unset $s and aborts under `set -u`.
  local s="$1"
  local i pid="${PID_OF_SESS[$s]:-}"
  [ -n "$pid" ] || pid=$(claude_pid_in "$s")
  [ -n "$pid" ] || return 0
  kill "$pid" 2>/dev/null || true
  for ((i = 0; i < 60; i++)); do
    kill -0 "$pid" 2>/dev/null || { unset "PID_OF_SESS[$s]"; return 0; }
    sleep 0.5
  done
  kill -9 "$pid" 2>/dev/null || true
  sleep 1
  unset "PID_OF_SESS[$s]"
}

# Stop the claude in a session and remove the session. Only ever this one
# session, by exact name: never `tmux kill-server`, which ends every tmux session
# on the host, the caller's own included.
close_sess() {
  local s="$1" pid
  stop_claude_in "$s"
  pid=$(claude_pid_in "$s")
  [ -z "$pid" ] || die "the claude in $s (pid $pid) did not exit. The session was kept."
  tmux kill-session -t "=$s" 2>/dev/null || true
}

# Wait up to 30 s for a live claude on conversation $2 in session $1.
wait_live() {
  local i pid id
  for ((i = 0; i < 60; i++)); do
    sleep 0.5
    pid=$(claude_pid_in "$1")
    [ -n "$pid" ] || continue
    id=$(conv_of_pid "$pid")
    [ "$id" = "$2" ] && { echo "$pid"; return 0; }
  done
  return 1
}

# --- target resolution -------------------------------------------------------
# Titles carry a host tag and punctuation nobody wants to retype, so matching
# ignores both: lowercase, drop a leading "[tag] ", and reduce every run of
# non-alphanumerics to one space. "pensi", "Pensi" and "[VPS] Pensi" then all
# name the same conversation.
norm_name() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
    sed -E 's/^\[[^]]*\][[:space:]]*//; s/[^a-z0-9]+/ /g; s/^ +//; s/ +$//'
}

# True when query $1 loosely names $2: a normalised substring, or every word of
# the query present in the name in any order.
name_matches() {
  local q n w
  q=$(norm_name "$1"); n=$(norm_name "$2")
  [ -n "$q" ] || return 1
  case "$n" in *"$q"*) return 0 ;; esac
  for w in $q; do
    case " $n " in *" $w "*) ;; *) return 1 ;; esac
  done
  return 0
}

# A running session: its tmux name, a conversation id or the first 8+ characters
# of one, or a loose match on its title. Refuses an ambiguous name rather than
# guessing. Call after scan_sessions.
resolve_sess() {
  local arg="$1" s hits=() t id
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    [ "$s" = "$arg" ] && { echo "$s"; return 0; }
  done
  if [[ "$arg" =~ ^[0-9a-f-]{8,36}$ ]]; then
    for id in "${!SESS_OF_CONV[@]}"; do
      [[ "$id" == "$arg"* ]] && hits+=("${SESS_OF_CONV[$id]}")
    done
    [ "${#hits[@]}" -eq 1 ] && { echo "${hits[0]}"; return 0; }
    hits=()
  fi
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    t=$(title_of_sess "$s")
    [ -n "$t" ] || continue
    name_matches "$arg" "$t" && hits+=("$s")
  done
  case "${#hits[@]}" in
    1) echo "${hits[0]}" ;;
    0) die "no running session matches '$arg' (try: claude-crew status)" ;;
    *) die "'$arg' matches ${#hits[@]} running sessions:"$'\n'"$(for s in "${hits[@]}"; do printf '  %s  %s\n' "$s" "$(title_of_sess "$s")"; done)" ;;
  esac
}

# A conversation id, from an id or a title substring. Searches well beyond what
# runs, so a stopped conversation can be addressed by name.
resolve_conv() {        # echoes "<id>\t<title>"
  local arg="$1" hits=() id title
  if [[ "$arg" =~ $UUID_RE ]]; then
    while IFS=$'\t' read -r id title; do
      [ "$id" = "$arg" ] && { printf '%s\t%s\n' "$id" "$title"; return 0; }
    done < <(list_convs 60)
    printf '%s\t\n' "$arg"; return 0
  fi
  while IFS=$'\t' read -r id title; do
    if [[ "$arg" =~ ^[0-9a-f-]{8,35}$ ]] && [[ "$id" == "$arg"* ]]; then hits+=("$id"$'\t'"$title"); continue; fi
    name_matches "$arg" "$title" && hits+=("$id"$'\t'"$title")
  done < <(list_convs 60)
  case "${#hits[@]}" in
    1) printf '%s\n' "${hits[0]}" ;;
    0) die "no conversation matches '$arg'" ;;
    *) die "'$arg' matches ${#hits[@]} conversations:"$'\n'"$(printf '  %s\n' "${hits[@]}")" ;;
  esac
}

# --- commands ----------------------------------------------------------------
cmd_setup() {
  # Re-running with no flags keeps every existing value, so setup is safe to
  # call from start/restart as a gate.
  [ -f "$CONF" ] && { # shellcheck disable=SC1090
    source "$CONF"; }
  local old_workdir; old_workdir=$(cd "$WORKDIR" 2>/dev/null && pwd || printf '%s' "$WORKDIR")
  while [ $# -gt 0 ]; do
    case "$1" in
      --workdir)         WORKDIR="$2"; shift 2 ;;
      --model)           MODEL="$2"; shift 2 ;;
      --effort)          EFFORT="$2"; shift 2 ;;
      --permission-mode) PERMISSION_MODE="$2"; shift 2 ;;
      --remote-control)  REMOTE_CONTROL="$2"; shift 2 ;;
      --autocompact)     AUTOCOMPACT="$2"; shift 2 ;;
      --tmux-prefix)     TMUX_PREFIX="$2"; shift 2 ;;
      --shell)           SHELL_CMD="$2"; shift 2 ;;
      --claude-bin)      CLAUDE_BIN="$2"; shift 2 ;;
      -h|--help)
        sed -n '/^cmd_setup/,/^}/p' "$0" | grep -o '^      --[a-z-]*' | tr -d ' '
        return 0 ;;
      *) die "setup: unknown flag $1" ;;
    esac
  done

  [ -d "$WORKDIR" ] || die "setup: --workdir $WORKDIR does not exist"
  case "$EFFORT" in low|medium|high|xhigh|max) ;; *) die "setup: --effort must be low|medium|high|xhigh|max" ;; esac
  case "$PERMISSION_MODE" in acceptEdits|auto|bypassPermissions|manual|dontAsk|plan) ;;
    *) die "setup: --permission-mode is not a value claude accepts" ;; esac
  case "$REMOTE_CONTROL" in on|off) ;; *) die "setup: --remote-control must be on or off" ;; esac
  # claude rejects a bad value at launch, which would leave every pane at a bare shell.
  [[ "$AUTOCOMPACT" =~ ^(auto|[0-9]+[kKmM]?)$ ]] || die "setup: --autocompact must be auto or a size from 100k to 1M"
  [[ "$TMUX_PREFIX" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || die "setup: --tmux-prefix must be letters and digits"

  # Transcripts are stored per working directory, and claude resumes a
  # conversation only from the directory it was started in. A session running
  # or saved under the current directory could not come back under a new one.
  WORKDIR=$(cd "$WORKDIR" && pwd)
  if [ -f "$CONF" ] && [ "$WORKDIR" != "$old_workdir" ]; then
    scan_sessions
    [ "${#PID_OF_SESS[@]}" -eq 0 ] ||
      die "setup: sessions still run in $old_workdir. Stop every session before changing the working directory."
    state_read
    [ "${#ST_ORDER[@]}" -eq 0 ] ||
      die "setup: saved sessions belong to $old_workdir and cannot resume from $WORKDIR. Stop them first (claude-crew stop <target>)."
  fi

  {
    echo "# crew.conf — written by \`claude-crew setup\`. Safe to edit by hand."
    echo "# Regenerate or patch with: claude-crew setup --model sonnet --effort high"
    local k
    for k in "${CONF_KEYS[@]}"; do printf '%s=%q\n' "$k" "${!k}"; done
  } > "$CONF"

  local pd; pd=$(projdir)
  echo "wrote $CONF"
  sed 's/^/  /' "$CONF" | grep -v '^  #'
  echo "  transcripts: $pd"
  [ -d "$pd" ] || echo "  WARNING: that transcript directory does not exist yet" >&2
}

# Machine-readable status for the web page. One JSON object on stdout.
cmd_status_json() {
  scan_sessions
  state_read
  local s id pid title m e state url tsv="" rid rtitle
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    id=${CONV_OF_SESS[$s]:-}; pid=${PID_OF_SESS[$s]:-}
    [ -n "$pid" ] || continue
    title=""; [ -n "$id" ] && title=$(conv_title "$id"); title=${title:-$(title_of_sess "$s")}
    IFS=$'\t' read -r m e < <(kept_flags "$s" "$id" 1)
    # Claude Code keeps live state per process in ~/.claude/sessions/<pid>.json,
    # including "bridgeSessionId", the remote-control session.
    local sf="$HOME/.claude/sessions/$pid.json" bridge=""
    if [ -f "$sf" ]; then
      bridge=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("bridgeSessionId",""))' "$sf" 2>/dev/null || true)
    fi
    url=""; [ -n "$bridge" ] && url="https://claude.ai/code/$bridge"
    state=$(sess_activity "$s")
    tsv+="$s"$'\t'"$id"$'\t'"$title"$'\t'"$state"$'\t'"$m"$'\t'"$e"$'\t'"${ST_MODEL[$id]:-}"$'\t'"${ST_EFFORT[$id]:-}"$'\t'"$url"$'\n'
  done
  local saved=""
  for rid in ${ST_ORDER[@]+"${ST_ORDER[@]}"}; do
    [ -n "${ST_MODEL[$rid]+x}" ] && [ -z "${SESS_OF_CONV[$rid]:-}" ] && saved+="$rid"$'\t'"${ST_TITLE[$rid]}"$'\n'
  done
  local convs=""
  while IFS=$'\t' read -r rid rtitle; do
    [ -n "$rid" ] && [ -z "${SESS_OF_CONV[$rid]:-}" ] && convs+="$rid"$'\t'"$rtitle"$'\n'
  done < <(list_convs 25)
  local boot=off d dupes=""
  if [ -f "${CREW_UNIT_DIR:-/etc/systemd/system}/claude-crew.service" ]; then boot=on; fi
  for d in ${DUPES[@]+"${DUPES[@]}"}; do dupes+="$d"$'\n'; done
  SESS_TSV="$tsv" SAVED_TSV="$saved" CONVS_TSV="$convs" DUPES_TXT="$dupes" python3 - \
    "$MODEL" "$EFFORT" "$REMOTE_CONTROL" "$AUTOCOMPACT" "$PERMISSION_MODE" "$boot" "$WORKDIR" <<'PY2'
import json, os, sys
model, effort, rc, ac, pm, boot, workdir = sys.argv[1:8]
mem = None
try:
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            mem = int(line.split()[1]) // 1024
except OSError:
    pass
out = {"defaults": {"model": model, "effort": effort, "remote_control": rc,
                    "autocompact": ac, "permission_mode": pm, "workdir": workdir},
       "boot": boot, "memory_available_mb": mem,
       "sessions": [], "saved_stopped": [], "conversations": [], "duplicates": []}
for line in os.environ["SESS_TSV"].splitlines():
    s, cid, title, state, m, e, sm, se, url = (line.split("\t") + [""] * 9)[:9]
    out["sessions"].append({"session": s, "id": cid or None, "title": title or None,
        "state": state, "model": m or None, "effort": e or None,
        "follows_default_model": sm == "-", "follows_default_effort": se == "-",
        "remote_url": url or None})
for key, env in (("saved_stopped", "SAVED_TSV"), ("conversations", "CONVS_TSV")):
    for line in os.environ[env].splitlines():
        cid, title = (line.split("\t") + [""])[:2]
        out[key].append({"id": cid, "title": title or None})
for line in os.environ["DUPES_TXT"].splitlines():
    cid, a, b = (line.split() + ["", "", ""])[:3]
    out["duplicates"].append({"id": cid, "sessions": [a, b]})
print(json.dumps(out))
PY2
}

cmd_status() {
  scan_sessions
  local s id t real n=0
  echo "sessions (workdir $WORKDIR, defaults $MODEL/$EFFORT/$PERMISSION_MODE, remote-control $REMOTE_CONTROL, autocompact $AUTOCOMPACT):"
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    id=${CONV_OF_SESS[$s]:-}; t=$(title_of_sess "$s")
    if [ -z "${PID_OF_SESS[$s]:-}" ]; then
      printf '  %s  <no claude running, shell only>\n' "$s"; continue
    fi
    n=$((n + 1))
    real=""; [ -n "$id" ] && real=$(conv_title "$id")
    printf '  %-8s  %-12s %s\n' "${id:0:8}" "$(sess_activity "$s")" "${real:-${t:-untitled}}"
    # The session name records the conversation it started on. A /resume or
    # /clear inside moves it to another, which relabel fixes.
    if [ -n "$id" ] && [ "$s" != "$(sess_of_conv "$id")" ]; then
      printf '  %-8s  %s\n' "" "session $s runs $id. claude-crew relabel renames it"
    fi
  done
  [ "$n" -gt 0 ] || echo "  (none running)"
  if [ "${#DUPES[@]}" -gt 0 ]; then
    echo "DUPLICATES — two live processes on one transcript:"
    local d did da db
    for d in "${DUPES[@]}"; do
      read -r did da db <<<"$d"
      printf '  %-8s is live in BOTH %s and %s — stop one\n' "${did:0:8}" "$da" "$db"
    done
  fi
  status_saved
}

# Which session is running the caller. Exists so the self-preservation guard can
# be checked without triggering it.
cmd_whoami() {
  scan_sessions
  detect_self
  if [ -z "$SELF_CONV" ] && [ -z "$SELF_SESS" ]; then
    echo "not running inside a claude (no claude ancestor)"
    echo "  stop commands will not be refused"
    return 0
  fi
  printf 'conversation  %s\n' "${SELF_CONV:-unknown}"
  if [ -n "$SELF_SESS" ]; then
    printf 'session       %s  %s\n' "$SELF_SESS" "$(title_of_sess "$SELF_SESS")"
    printf 'protected     stop commands aimed at it are refused without --self\n'
  else
    echo "session       none of the crew's sessions"
    echo "protected     no, this session is outside the crew"
  fi
}

# Rename each session after the conversation it runs, and its window after that
# conversation's title. A /resume or /clear inside a session moves it to another
# conversation, and /rename changes a title, without either touching tmux.
cmd_relabel() {
  scan_sessions
  local s id want t cur changed=0
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    id=${CONV_OF_SESS[$s]:-}
    [ -n "$id" ] || continue
    want=$(sess_of_conv "$id")
    if [ "$s" != "$want" ] && ! tmux has-session -t "=$want" 2>/dev/null; then
      tmux rename-session -t "=$s" "$want"
      printf '  session %s -> %s\n' "$s" "$want"
      s="$want"; changed=$((changed + 1))
    fi
    t=$(conv_title "$id"); cur=$(title_of_sess "$s")
    if [ -n "$t" ] && [ "$t" != "$cur" ]; then
      tmux rename-window -t "$s" "$t"
      printf '  window "%s" -> "%s"\n' "$cur" "$t"
      changed=$((changed + 1))
    fi
  done
  if [ "$changed" -eq 0 ]; then echo "every session and window already matches what it runs"; fi
  return 0
}

# Rename the numbered sessions of older versions ("Claude1") after the
# conversation each runs. Claude keeps running: tmux renames a live session. A
# numbered session with no claude in it is only a shell, and is closed.
cmd_migrate() {
  scan_sessions
  local s id want renamed=0 closed=0
  for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
    [[ "$s" =~ ^${TMUX_PREFIX}[0-9]+$ ]] || continue
    id=${CONV_OF_SESS[$s]:-}
    if [ -z "${PID_OF_SESS[$s]:-}" ]; then
      tmux kill-session -t "=$s" && echo "  closed $s, a shell with no claude" && closed=$((closed + 1))
      continue
    fi
    [ -n "$id" ] || { echo "  kept $s: its claude has no conversation id yet" >&2; continue; }
    want=$(sess_of_conv "$id")
    if tmux has-session -t "=$want" 2>/dev/null; then
      echo "  kept $s: $want already exists" >&2; continue
    fi
    tmux rename-session -t "=$s" "$want"
    printf '  %s -> %s  (%s)\n' "$s" "$want" "$(title_of_sess "$want")"
    renamed=$((renamed + 1))
  done
  if [ ! -f "$STATE" ] && [ -f "$LEGACY_STATE" ]; then
    state_read; state_write
    mv -f "$LEGACY_STATE" "$LEGACY_STATE.migrated"
    echo "  saved set moved to $STATE"
  fi
  echo "migrate: $renamed renamed, $closed closed"
}

cmd_start() {
  local force=0 dry=0 a
  for a in "$@"; do
    case "$a" in
      --force)   force=1 ;;
      --dry-run) dry=1 ;;
      *) die "start: usage: claude-crew start [--force] [--dry-run]" ;;
    esac
  done
  if [ "$force" = 1 ] && [ "$dry" = 1 ]; then die "start: --force and --dry-run do not combine"; fi

  state_read
  if [ "${#ST_ORDER[@]}" -eq 0 ]; then
    echo "nothing is saved, so there is nothing to start"
    echo "hint: claude-crew resume <conversation> starts one, and claude-crew save keeps what runs" >&2
    return 0
  fi
  scan_sessions
  detect_self

  if [ "$force" = 1 ]; then
    # --force stops every session, so running it from inside one is always fatal
    # to the caller. Under systemd there is no claude ancestor, SELF_SESS is
    # empty, and this does not fire — which is how `restart` does the same work.
    if [ -n "$SELF_SESS" ]; then refuse_self "$SELF_SESS" "start --force"; fi
    local s
    for s in "${!PID_OF_SESS[@]}"; do guard_busy "$s" "start --force"; done
    # Stop every running session first, in a separate pass, so no conversation
    # is ever started while its old process is still alive: two processes
    # appending to one transcript corrupt it.
    for s in "${!PID_OF_SESS[@]}"; do stop_claude_in "$s"; done
    local i still
    for ((i = 0; i < 60; i++)); do
      still=0
      for s in ${SESSIONS[@]+"${SESSIONS[@]}"}; do
        [ -n "$(claude_pid_in "$s")" ] && { still=1; break; }
      done
      [ "$still" -eq 0 ] && break
      sleep 0.5
    done
    [ "${still:-0}" -eq 0 ] || echo "warning: old sessions still alive after 30s; launching anyway" >&2
    scan_sessions
  fi

  [ "$dry" = 1 ] && echo "plan:"
  local started=0 kept=0 skipped=0 id title model effort s pd
  local -a expect=()
  pd=$(projdir)
  for id in "${ST_ORDER[@]}"; do
    [ -n "${ST_MODEL[$id]+x}" ] || continue
    title=${ST_TITLE[$id]}; model=${ST_MODEL[$id]}; effort=${ST_EFFORT[$id]}
    [ "$model" = "-" ] && model=""
    [ "$effort" = "-" ] && effort=""
    model=${model:-$MODEL}; effort=${effort:-$EFFORT}
    # Already live somewhere? Leave it exactly where it is.
    if [ -n "${SESS_OF_CONV[$id]:-}" ]; then
      printf '  %-8s already running  (%s)\n' "${id:0:8}" "${title:-untitled}"
      kept=$((kept + 1)); expect+=("$id"); continue
    fi
    if [ ! -f "$pd/$id.jsonl" ]; then
      printf '  %-8s SKIPPED — its transcript is gone  (%s)\n' "${id:0:8}" "${title:-untitled}"
      skipped=$((skipped + 1)); continue
    fi
    s=$(sess_of_conv "$id")
    if [ "$dry" = 1 ]; then
      printf '  %-8s would start on %s/%s  (%s)\n' "${id:0:8}" "$model" "$effort" "${title:-untitled}"
    else
      start_claude_in "$s" "$id" "$title" "$model" "$effort"
      printf '  %-8s started on %s/%s  (%s)\n' "${id:0:8}" "$model" "$effort" "${title:-untitled}"
      started=$((started + 1))
    fi
    expect+=("$id")
  done
  printf 'summary: %s started, %s already running, %s skipped\n' "$started" "$kept" "$skipped"
  [ "$dry" = 1 ] && return 0

  # `tmux send-keys` returns 0 as soon as tmux ACCEPTS the keystrokes. It says
  # nothing about whether the command ran or the process survived. Counting that
  # as "started" is how a run that launched nothing still reported five
  # successes. Verify against the only thing that matters: a live process.
  local -a dead=()
  local live=0 rid
  if [ "$started" -gt 0 ]; then
    for ((i = 0; i < 20; i++)); do
      sleep 1; scan_sessions; live=0
      for rid in "${expect[@]}"; do [ -n "${SESS_OF_CONV[$rid]:-}" ] && live=$((live + 1)); done
      [ "$live" -eq "${#expect[@]}" ] && break
    done
    for rid in "${expect[@]}"; do [ -n "${SESS_OF_CONV[$rid]:-}" ] || dead+=("${rid:0:8}"); done
    printf 'verify: %s/%s sessions hold a live claude\n' "$live" "${#expect[@]}"
  fi
  save_state
  if [ "${#dead[@]}" -gt 0 ]; then
    printf 'ERROR: no live process for: %s\n' "${dead[*]}" >&2
    exit 4
  fi
}

# Restart every session WITHOUT killing the caller. Running `claude-crew start
# --force` inline stops the calling session's own claude mid-turn and wedges its
# remote control, so hand the job to systemd: the caller's shell is already gone
# when the restart fires.
#
# Two properties are load-bearing, each learned the hard way:
#   HOME=/root       systemd-run starts with a minimal env; `set -u` aborts on
#                    an unset $HOME.
#   unique unit name a transient unit can wedge in `loaded inactive dead` where
#                    --collect never GCs it; a fixed name then fails forever
#                    with "Unit already exists".
#
# Do NOT swap systemd for setsid/nohup + sleep — that leaves a sleeping child
# that can still be reaped along with the session.
#
# A clean journal does NOT mean it worked. Confirm with `claude-crew status` and the
# `verify: N/N` line, never the exit code.
cmd_restart() {
  local delay="${1:-15}" unit="crew-restart-$(date +%s)"
  save_state
  echo "saved what runs to $STATE"
  local when=--wait-idle
  [ "$INTERRUPT" = 1 ] && when=--interrupt
  systemd-run --on-active="$delay" --unit="$unit" --collect \
    --setenv=HOME="$HOME" --property=KillMode=process \
    "$CREW_DIR/bin/claude-crew" "$when" start --force
  echo "scheduled $unit in ${delay}s"
  if [ "$when" = --wait-idle ]; then
    echo "a session still working then is waited on, up to 15 minutes. A session holding an unsent draft stops the restart. --interrupt skips both checks"
  fi
  echo "verify after it fires:  claude-crew status  &&  journalctl -u $unit | grep verify:"
}

# Start a brand new conversation in its own session. The crew picks the id
# (--session-id), so the session is named before claude starts.
cmd_new() {
  [ $# -eq 1 ] && [ -n "$1" ] || die 'new: usage: claude-crew new "<title>"'
  local title="$1" id s pid
  id=$(new_uuid); s=$(sess_of_conv "$id")
  start_claude_in "$s" "$id" "$title" "" "" new
  echo "started \"$title\" in $s"
  pid=$(wait_live "$s" "$id") || { echo "ERROR: no live claude on $id in $s after 30s" >&2; exit 4; }
  printf 'verify: %s holds a live claude (pid %s)\n' "$s" "$pid"
  save_state
}

# Start a stopped conversation in its own session, on the model and effort it
# last ran with.
cmd_resume() {
  [ $# -eq 1 ] || die "resume: usage: claude-crew resume <conversation>"
  scan_sessions
  local id title; IFS=$'\t' read -r id title < <(resolve_conv "$1")
  if [ -n "${SESS_OF_CONV[$id]:-}" ]; then
    echo "already running: ${title:-${id:0:8}} in ${SESS_OF_CONV[$id]}"; return 0
  fi
  [ -f "$(projdir)/$id.jsonl" ] || die "resume: no transcript for $id"
  local m e s pid; IFS=$'\t' read -r m e < <(kept_flags "" "$id")
  s=$(sess_of_conv "$id")
  start_claude_in "$s" "$id" "$title" "$m" "$e"
  pid=$(wait_live "$s" "$id") || { echo "ERROR: ${id:0:8} did not come up in $s" >&2; exit 4; }
  echo "verify: ${title:-${id:0:8}} is live in $s (pid $pid) on ${m:-$MODEL}/${e:-$EFFORT}"
  save_state
}

# Clear a session's context. A new, empty conversation starts in its own session
# with the same title, model and effort, and the conversation it replaces is
# deleted, with its sidecar and uploads. There is no backup, so a bare run only
# prints the plan.
#
# This is not Claude Code's /clear. That one starts a new conversation inside the
# same process and keeps the old one on disk. The process carries the `-n` name
# it was launched with, so the new conversation gets the same title, and the
# store ends up with two conversations under one name. `cleared` below handles
# a /clear that happens anyway.
cmd_clear() {
  local usage='clear: usage: claude-crew clear <target> [--yes]'
  local target="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      -*) die "clear: unknown flag $1" ;;
      *)
        [ -z "$target" ] || die "$usage"
        target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die "$usage"

  scan_sessions
  detect_self
  local s; s=$(resolve_sess "$target")
  local old="${CONV_OF_SESS[$s]:-}" title pd
  [ -n "$old" ] || die "clear: $s holds no conversation to clear"
  title=$(conv_title "$old"); title=${title:-$(title_of_sess "$s")}
  pd=$(projdir)

  printf 'session       %s\n' "$s"
  printf 'title         %s  (kept)\n' "${title:-untitled}"
  printf 'conversation  %s  (will be deleted, with its sidecar and uploads)\n' "$old"
  [ -f "$pd/$old.jsonl" ] && printf 'transcript    %s bytes\n' "$(stat -c %s "$pd/$old.jsonl")"
  [ -d "$HOME/.claude/uploads/$old" ] &&
    printf 'uploads       %s bytes in %s/\n' "$(du -sb "$HOME/.claude/uploads/$old" | cut -f1)" "$HOME/.claude/uploads/$old"
  echo "A new, empty conversation starts with the same title, model and effort."
  echo "This is not Claude Code's /clear, which keeps the old conversation under the same name."
  if [ "$yes" != 1 ]; then
    echo "nothing done. Run again with --yes to clear it. There is no backup."
    return 0
  fi
  # Aimed at your own session this defers onto a timer, because stopping your
  # own claude kills the shell that would have started the replacement.
  refuse_self "$s" "clear"
  guard_busy "$s" "clear"

  local m e sm="" se=""
  IFS=$'\t' read -r m e < <(kept_flags "$s" "$old")
  state_read
  if [ -n "${ST_MODEL[$old]+x}" ]; then sm="${ST_MODEL[$old]}"; se="${ST_EFFORT[$old]}"; fi

  close_sess "$s"
  local new ns pid
  new=$(new_uuid); ns=$(sess_of_conv "$new")
  start_claude_in "$ns" "$new" "$title" "$m" "$e" new
  if ! pid=$(wait_live "$ns" "$new"); then
    echo "ERROR: $ns has no live claude after 30s. The old conversation $old was kept." >&2
    exit 4
  fi
  printf 'verify: %s runs new conversation %s (pid %s)\n' "$ns" "$new" "$pid"

  # Carry the old entry's model and effort, "-" included, over to the new one.
  state_read
  state_drop "$old"
  local nm="${sm:-${m:-$MODEL}}" ne="${se:-${e:-$EFFORT}}"
  [ -z "$sm" ] && [ "$nm" = "$MODEL" ] && nm="-"
  [ -z "$se" ] && [ "$ne" = "$EFFORT" ] && ne="-"
  state_put "$new" "$nm" "$ne" "$title"
  state_write

  if [ -f "$pd/$old.jsonl" ]; then
    cmd_delete "$old" --yes
  else
    echo "$old never wrote a transcript, so there is nothing to delete"
  fi
}

# SessionStart hook, matcher "clear". Registered in ~/.claude/settings.json.
# CREW_WEB_URL, when set, names the web page in the notice.
#
# Claude Code's /clear starts a new conversation in the same process and keeps
# the old one under the same title. This renames the session after the new
# conversation, records it in the saved set, and prints a notice into the new
# session's context so that it asks the user before the old conversation is
# deleted. It deletes nothing itself.
cmd_cleared() {
  local new
  new=$(python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("session_id","") or "")
except Exception: print("")' 2>/dev/null) || new=""
  [[ "$new" =~ $UUID_RE ]] || return 0
  scan_sessions
  local s; s=$(caller_sess)
  [ -n "$s" ] || return 0                 # a claude outside the crew
  local old=""
  [[ "$s" =~ ^${TMUX_PREFIX}_(.+)$ ]] && old="${BASH_REMATCH[1]}"
  [[ "$old" =~ $UUID_RE ]] && [ "$old" != "$new" ] || return 0
  local want; want=$(sess_of_conv "$new")
  tmux has-session -t "=$want" 2>/dev/null || tmux rename-session -t "=$s" "$want"
  state_read
  local title="${ST_TITLE[$old]:-$(title_of_sess "$want")}"
  if [ -n "${ST_MODEL[$old]+x}" ]; then
    state_put "$new" "${ST_MODEL[$old]}" "${ST_EFFORT[$old]}" "$title"
    state_drop "$old"
    state_write
  fi
  [ -f "$(projdir)/$old.jsonl" ] || return 0
  cat <<NOTICE
claude-crew: the user just ran Claude Code's built-in /clear.
It started this new conversation ($new) but did NOT delete the previous one.
The previous conversation $old ("${title:-untitled}") is still on disk under the same title,
so the crew now has two conversations with one name.
The crew now saves this session under the new conversation.

In your first reply, before anything else, tell the user this in two or three sentences
and ask whether to delete the previous conversation. Delete it only after they say yes:
  $CREW_DIR/bin/claude-crew delete $old --yes
NOTICE
  if [ -n "${CREW_WEB_URL:-}" ]; then
    echo "They can also delete it from the Stopped list at $CREW_WEB_URL."
  fi
  cat <<NOTICE
Tell them that next time "claude-crew clear" (Clear Context on the crew web page) clears
a session in one step: it asks first and leaves no duplicate.
NOTICE
}

# Every live claude pid whose session registry names conversation $1, inside the
# crew or not. The registry is keyed by pid, so this also finds a claude running
# in a plain terminal that no session knows about.
live_pids_of_conv() {
  local f pid
  for f in "$HOME"/.claude/sessions/*.json; do
    [ -e "$f" ] || continue
    pid=${f##*/}; pid=${pid%.json}
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [ -r "/proc/$pid/cmdline" ] || continue
    if [ "$(conv_of_pid "$pid")" = "$1" ]; then echo "$pid"; fi
  done
}

# Delete a conversation for good: its transcript, its sidecar directory
# (tool-results, subagents, custom-title.json) and its uploads. There is no
# backup, so a bare run only prints what would go, and --yes is required to act.
cmd_delete() {
  local usage='delete: usage: claude-crew delete <conversation> [--yes]'
  local target="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      -*) die "delete: unknown flag $1" ;;
      *)
        [ -z "$target" ] || die "$usage"
        target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die "$usage"

  scan_sessions
  detect_self
  local id title
  IFS=$'\t' read -r id title < <(resolve_conv "$target")
  # The id becomes part of an `rm -rf` path. An empty or odd id would point that
  # at the whole transcript store.
  [[ "$id" =~ $UUID_RE ]] || die "delete: '$id' is not a conversation id. Nothing was deleted."

  # Uploads live OUTSIDE the transcript store, keyed by conversation id, so
  # deleting the transcript alone strands them. One 14 MB apk sat there with
  # nothing left pointing at it.
  local pd file side ups
  pd=$(projdir)
  file="$pd/$id.jsonl"
  side="$pd/$id"
  ups="$HOME/.claude/uploads/$id"
  [ -f "$file" ] || die "delete: no transcript at $file"

  # No --self escape here. A stopped session can be started again. A deleted
  # transcript cannot.
  if [ -n "$SELF_CONV" ] && [ "$id" = "$SELF_CONV" ]; then
    die "delete: $id (${title:-untitled}) is the conversation you are running in.
     Refusing. --self does not apply to delete."
  fi

  printf 'conversation  %s\n' "$id"
  printf 'title         %s\n' "${title:-untitled}"
  printf 'transcript    %s  (%s bytes)\n' "$file" "$(stat -c %s "$file")"
  if [ -d "$side" ]; then
    printf 'sidecar dir   %s/  (%s bytes)\n' "$side" "$(du -sb "$side" | cut -f1)"
  else
    printf 'sidecar dir   none\n'
  fi
  if [ -d "$ups" ]; then
    printf 'uploads dir   %s/  (%s bytes)\n' "$ups" "$(du -sb "$ups" | cut -f1)"
  else
    printf 'uploads dir   none\n'
  fi

  # A claude outside the crew is not ours to stop. Deleting under it would leave
  # it appending to a transcript that no longer exists.
  local p managed outside=() s
  for p in $(live_pids_of_conv "$id"); do
    managed=0
    for s in "${!PID_OF_SESS[@]}"; do [ "${PID_OF_SESS[$s]}" = "$p" ] && managed=1; done
    if [ "$managed" = 0 ]; then outside+=("$p"); fi
  done
  if [ "${#outside[@]}" -gt 0 ]; then
    die "delete: it is live outside the crew (pid ${outside[*]}).
     Stop that claude yourself first. Nothing was deleted."
  fi

  s="${SESS_OF_CONV[$id]:-}"
  if [ -n "$s" ]; then
    printf 'live in       %s (pid %s), stopped before deleting\n' "$s" "${PID_OF_SESS[$s]}"
  else
    printf 'live in       no session\n'
  fi

  if [ "$yes" != 1 ]; then
    echo "nothing deleted. Run again with --yes to delete it permanently. There is no backup."
    return 0
  fi

  if [ -n "$s" ]; then guard_busy "$s" "delete"; fi

  # Loop, because a conversation held by two sessions at once (see DUPES) is
  # listed under only one of them per scan.
  local tries=0
  while conv_is_live "$id"; do
    s=${SESS_OF_CONV[$id]}
    if [ "$s" = "${SELF_SESS:-}" ]; then
      die "delete: $s is the session you are running in. Nothing was deleted."
    fi
    echo "stopping $s (pid ${PID_OF_SESS[$s]})"
    close_sess "$s"
    tries=$((tries + 1))
    [ "$tries" -le 10 ] || die "delete: $id is still live after stopping $tries sessions. Nothing was deleted."
  done

  rm -f -- "$file"
  if [ -d "$side" ]; then rm -rf -- "$side"; fi
  if [ -d "$ups" ]; then rm -rf -- "$ups"; fi
  if [ -e "$file" ] || [ -e "$side" ] || [ -e "$ups" ]; then
    die "delete: something is left behind for $id"
  fi
  rm -rf -- "$HOME/.claude/session-env/$id"
  echo "deleted $id (${title:-untitled})"
  state_read; state_drop "$id"; state_write
}

# What is currently sitting in a session's input box.
#
# Prints "" when the box is empty, the draft text when it holds one, and
# "<<no-input-box>>" when the box is not drawn at all, which is how a session
# mid-turn or compacting appears. The box is the region between the last two
# horizontal rules on screen, so this survives wrapping, resizing, and a long
# paste being collapsed to a placeholder.
input_box() {
  local tmp; tmp=$(mktemp)
  tmux capture-pane -p -e -t "$1" > "$tmp" 2>/dev/null || true
  python3 - "$tmp" <<'PY'
import sys, re
# The box shows a suggested prompt as dim text (ESC[2m). It is not a draft, so
# drop dim runs, then the remaining escape codes.
dim = re.compile(r"\x1b\[2m.*?(?:\x1b\[(?:0|22)m|$)")
ansi = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
lines = [ansi.sub("", dim.sub("", l.rstrip("\n"))).replace("\xa0", " ")
         for l in open(sys.argv[1], encoding="utf-8", errors="replace")]
rules = [i for i, l in enumerate(lines) if re.match(r"^\s*[─—]{6,}", l)]
if len(rules) < 2:
    print("<<no-input-box>>"); raise SystemExit
body = " ".join(lines[rules[-2] + 1: rules[-1]]).strip()
if body.startswith("❯"):                 # the prompt chevron
    body = body[1:].strip()
if body in ("Press up to edit queued messages",):   # shown while the box is empty
    body = ""
print(body)
PY
  rm -f "$tmp"
}

# Type a prompt into a session's running claude. This is a real prompt, not a
# message: remote control regularly wedges at "pending" after a model or effort
# change, and the tty always accepts input.
cmd_prompt() {
  [ $# -ge 2 ] || die "prompt: usage: claude-crew prompt <target> <text...>"
  scan_sessions
  detect_self
  local s; s=$(resolve_sess "$1"); shift
  # Prompting your own session is not fatal, only confusing: the text queues
  # behind the turn that sent it. Warn rather than refuse.
  if [ -n "$SELF_SESS" ] && [ "$s" = "$SELF_SESS" ]; then
    echo "note: that is the session you are running in; the prompt queues behind this turn" >&2
  fi
  # Guard hard. With shell-first panes, a session whose claude has exited is
  # sitting at a ROOT SHELL PROMPT, and send-keys would execute the prompt text
  # as a command.
  [ -n "${PID_OF_SESS[$s]:-}" ] || die "$s has no running claude — refusing to type into its shell"
  local text="$*"
  # A literal newline submits the input box, so a multi-line prompt would be
  # sent as several separate turns. Collapse to spaces and say so.
  case "$text" in *$'\n'*) text=${text//$'\n'/ }; echo "note: newlines collapsed to spaces" >&2 ;; esac

  # Look at the input box BEFORE typing anything. The box must be on screen, or
  # the session is mid-turn and swallows the keystrokes. And it must be EMPTY: a
  # draft someone left unsent is not ours to type over, and not ours to clear.
  local before; before=$(input_box "$s")
  case "$before" in
    "<<no-input-box>>")
      die "$s has no input box on screen — it is mid-turn or compacting.
     Nothing was typed. Try again once it is idle." ;;
    "") ;;
    *)
      die "$s has an unsent draft in its input box:
       \"$before\"
     Refusing to type over it. Nothing was typed." ;;
  esac

  tmux send-keys -t "$s" -l -- "$text"

  # Confirm by asking whether the box went from empty to non-empty, NOT by
  # looking for the text. The interface collapses a long paste to a placeholder,
  # so a text match fails on a perfectly idle session. Emptiness is
  # length-independent. Failure means the box came back empty, so there is no
  # leftover text to remove.
  #
  # Do not reach for C-u here. It does not clear this input box at all: 700
  # characters survived it untouched, verified 2026-09-03. C-c does clear it,
  # and also interrupts whatever turn the session has started since.
  #
  # The redraw can lag the keystrokes, and until it lands the box still shows
  # the dim suggestion, which reads as empty. Give it up to 3 s.
  local after="" i
  for ((i = 0; i < 6; i++)); do
    sleep 0.5
    after=$(input_box "$s")
    [ -n "$after" ] && [ "$after" != "<<no-input-box>>" ] && break
  done
  if [ -z "$after" ] || [ "$after" = "<<no-input-box>>" ]; then
    die "$s did not accept the text. Nothing was submitted."
  fi
  tmux send-keys -t "$s" Enter
  echo "prompted $(title_of_sess "$s") ($s): $text"
}

# Model and effort are launch flags, so changing one means stopping the process
# and starting it again on the same conversation, in the same pane.
relaunch_with() {       # $1=target $2=model-or-empty $3=effort-or-empty [$4=what was asked]
  scan_sessions
  detect_self
  local s; s=$(resolve_sess "$1")
  refuse_self "$s" "${4:-changing model or effort}"
  guard_busy "$s" "${4:-changing model or effort}"
  local id="${CONV_OF_SESS[$s]:-}" title; title=$(conv_title "$id"); title=${title:-$(title_of_sess "$s")}
  [ -n "$id" ] || die "$s holds no resumable conversation"
  local keep_m keep_e; IFS=$'\t' read -r keep_m keep_e < <(kept_flags "$s" "$id")
  local m="${2:-$keep_m}" e="${3:-$keep_e}" follow_m="" follow_e=""
  [ "$m" = "default" ] && { m=""; follow_m=1; }
  [ "$e" = "default" ] && { e=""; follow_e=1; }
  stop_claude_in "$s"
  # A session named for another conversation (after a /resume inside it) is
  # renamed now, while nothing runs in it.
  local want; want=$(sess_of_conv "$id")
  if [ "$s" != "$want" ] && ! tmux has-session -t "=$want" 2>/dev/null; then
    tmux rename-session -t "=$s" "$want"; s="$want"
  fi
  start_claude_in "$s" "$id" "$title" "$m" "$e"
  if wait_live "$s" "$id" >/dev/null; then
    echo "verify: $s ($title) live on ${m:-$MODEL}/${e:-$EFFORT}"
    save_state
    if [ -n "$follow_m$follow_e" ]; then
      state_read
      [ -n "$follow_m" ] && ST_MODEL[$id]="-"
      [ -n "$follow_e" ] && ST_EFFORT[$id]="-"
      state_write
    fi
  else
    echo "ERROR: $s did not come back up" >&2
    exit 4
  fi
}

cmd_model() {
  [ $# -eq 2 ] || die "model: usage: claude-crew model <target> <model|default>"
  relaunch_with "$1" "$2" ""
}

cmd_effort() {
  [ $# -eq 2 ] || die "effort: usage: claude-crew effort <target> <low|medium|high|xhigh|max|default>"
  case "$2" in low|medium|high|xhigh|max|default) ;; *) die "effort: must be low|medium|high|xhigh|max|default" ;; esac
  relaunch_with "$1" "" "$2"
}

# Stop and resume one session on the conversation, model and effort it runs now.
cmd_relaunch() {
  [ $# -eq 1 ] || die "relaunch: usage: claude-crew relaunch <target>"
  relaunch_with "$1" "" "" "relaunch"
}

# Stop a session, remove it, and drop it from the saved set, so start and restart
# leave it stopped. The transcript is kept; `claude-crew resume` brings it back.
cmd_stop() {
  [ $# -eq 1 ] || die "stop: usage: claude-crew stop <target>"
  # Save first. On a host that has never saved, dropping one session from an
  # empty record would leave every OTHER session unsaved, and the next start
  # would find nothing to launch.
  save_state
  detect_self
  local s; s=$(resolve_sess "$1")
  refuse_self "$s" "stop"
  guard_busy "$s" "stop"
  local id="${CONV_OF_SESS[$s]:-}" title; title=$(title_of_sess "$s")
  echo "stopping ${title:-untitled} ($s)"
  close_sess "$s"
  if [ -n "$id" ]; then state_read; state_drop "$id"; state_write; fi
  echo "stopped${id:+. Transcript $id is kept, and claude-crew resume brings it back}"
}

cmd_save() {
  save_state
  echo "wrote $STATE"
  status_saved
}

# Start the saved sessions after a reboot. Nothing else on this host does.
cmd_boot() {
  local unit_dir="${CREW_UNIT_DIR:-/etc/systemd/system}"
  local sysctl="${CREW_SYSTEMCTL:-systemctl}"
  local unit="$unit_dir/claude-crew.service"
  case "${1:-status}" in
    on)
      state_read
      if [ "${#ST_ORDER[@]}" -eq 0 ]; then
        echo "note: nothing is saved yet, so at boot start brings back nothing. Run claude-crew save to keep what runs." >&2
      fi
      cat > "$unit" <<UNIT
[Unit]
Description=claude-crew: start the saved Claude Code sessions after boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=$HOME
ExecStart=$CREW_DIR/bin/claude-crew start
# The first tmux server of the boot is spawned inside this unit's cgroup.
# KillMode=process keeps systemd from killing it, and every session in it,
# when this unit is stopped.
KillMode=process
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT
      "$sysctl" daemon-reload
      "$sysctl" enable claude-crew.service
      echo "boot on: wrote $unit and enabled it"
      echo "after the next reboot it runs 'claude-crew start' once the network is up. The running sessions were not touched."
      ;;
    off)
      if [ -f "$unit" ]; then
        "$sysctl" disable claude-crew.service || true
        rm -f "$unit"
        "$sysctl" daemon-reload
      fi
      echo "boot off: nothing starts the sessions at boot"
      ;;
    status)
      if [ -f "$unit" ]; then
        printf 'boot: unit at %s, %s\n' "$unit" "$("$sysctl" is-enabled claude-crew.service 2>/dev/null; true)"
      else
        echo "boot: off. Nothing starts the sessions at boot. Turn on with: claude-crew boot on"
      fi
      ;;
    *) die "boot: usage: claude-crew boot on|off|status" ;;
  esac
}

cmd_update() {
  echo "current: $("$CLAUDE_BIN" --version)"
  "$CLAUDE_BIN" install latest
  echo "now:     $("$CLAUDE_BIN" --version)"
  cmd_restart "${1:-15}"
}

# --- dispatch ----------------------------------------------------------------
# Global flags may appear anywhere; strip them before the subcommand sees the
# args. ORIG_ARGS keeps the line as given, because --self re-runs it on a timer.
ORIG_ARGS=("$@")
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --self) ALLOW_SELF=1; shift ;;
    --interrupt) INTERRUPT=1; shift ;;
    --wait-idle) WAIT_IDLE=1; shift ;;
    --in)
      [ $# -ge 2 ] || die "--in needs a number of seconds"
      [[ "$2" =~ ^[0-9]+$ ]] || die "--in takes seconds as a number, not '$2'"
      DEFER_DELAY="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

cmd="${1:-status}"; shift || true
case "$cmd" in
  setup)    cmd_setup "$@" ;;
  status)   load_conf; if [ "${1:-}" = "--json" ]; then cmd_status_json; else cmd_status "$@"; fi ;;
  whoami)   load_conf; cmd_whoami "$@" ;;
  relabel)  load_conf; cmd_relabel "$@" ;;
  migrate)  load_conf; cmd_migrate "$@" ;;
  start)    load_conf; cmd_start "$@" ;;
  restart)  load_conf; cmd_restart "$@" ;;
  stop)     load_conf; cmd_stop "$@" ;;
  save)     load_conf; cmd_save "$@" ;;
  boot)     load_conf; cmd_boot "$@" ;;
  new)      load_conf; cmd_new "$@" ;;
  resume)   load_conf; cmd_resume "$@" ;;
  clear)    load_conf; cmd_clear "$@" ;;
  cleared)  load_conf; cmd_cleared "$@" ;;
  delete)   load_conf; cmd_delete "$@" ;;
  prompt)   load_conf; cmd_prompt "$@" ;;
  model)    load_conf; cmd_model "$@" ;;
  effort)   load_conf; cmd_effort "$@" ;;
  relaunch) load_conf; cmd_relaunch "$@" ;;
  update)   load_conf; cmd_update "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;$d' ;;
  *) die "unknown command '$cmd' (try: claude-crew --help)" ;;
esac
